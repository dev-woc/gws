# Neon Postgres (required)
DATABASE_URL=

# Resend — for contact form email delivery (required)
RESEND_API_KEY=

# Where contact form submissions are sent (defaults to jamere@gordonwealthstrategies.com)
CONTACT_EMAIL=jamere@gordonwealthstrategies.com

# Calendly booking link shown on contact page
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link

# Calendly webhook signing key — from Calendly Developer → Webhooks → Signing Key
# Register webhook URL: https://gordonwealthstrategies.com/api/calendly/webhook
CALENDLY_WEBHOOK_SIGNING_KEY=

# Google Analytics GA4 (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
